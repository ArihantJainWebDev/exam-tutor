# Copy to .env.local. Never commit real keys.

# LLM gateway (OpenAI-compatible chat completions endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 1 = serve every model call from mocks/<prompt>.json. The whole demo runs offline in this mode.
MOCK_LLM=1
# 1 = write successful live responses back into mocks/ as fixtures (dev only)
CACHE_LLM=0
