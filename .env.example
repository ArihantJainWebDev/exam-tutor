# Copy to .env.local. Never commit real keys.

# LLM gateway (OpenAI-compatible chat completions endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Product calls always use the live API. This legacy flag is only read by explicit unit-test fixture requests.
MOCK_LLM=0
# Only explicit test fixture requests can cache fixtures; product reasoning is never written to mocks.
CACHE_LLM=0

# Optional absolute path on a persistent writable disk; default is data/store.json.
# Use one running Node instance with this local-file store.
# REDPEN_DATA_FILE=/app/data/store.json

# Vercel: connect Upstash Redis in Storage/Marketplace; credentials stay server-side.
# auto uses Redis when credentials exist; Vercel refuses an unsafe file-store fallback.
REDPEN_STORE=auto
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Vercel's KV_REST_API_URL / KV_REST_API_TOKEN names are also supported.
# Vercel Redis integration's REDIS_KV_REST_API_URL / REDIS_KV_REST_API_TOKEN are supported too.
REDPEN_REDIS_KEY=redpen:demo:v1

# Required for signed learner and teacher sessions. Generate independent random values.
SESSION_SECRET=
TEACHER_ACCESS_CODE=
REDPEN_COHORT_ID=physics
